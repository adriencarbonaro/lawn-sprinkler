menu "Lawn Sprinkler Controller Settings"

# Wifi configuration -----------------------------------------------------------

config WIFI_SSID
    string "WiFi SSID"

config WIFI_PASSWORD
    string "WiFi Password"

# MQTT configuration -----------------------------------------------------------

config MQTT_URI
    string "MQTT Uri (format: mqtt://[USER]:[PASSWORD]@[HOST]:[PORT])"

config MQTT_TOPIC_PREFIX
    string "MQTT topic prefix (must end with '/')"
    default "lawn-sprinkler/"

config MQTT_TOPIC_VERSION
    string "MQTT version topic name"
    default "version"

# Device identity --------------------------------------------------------------

config DEVICE_ID
    string "Device ID (used in HA discovery unique ids)"
    default "lawn_sprinkler"

config DEVICE_NAME
    string "Device friendly name"
    default "Lawn Sprinkler"

# Time -------------------------------------------------------------------------

config NTP_SERVER
    string "NTP server"
    default "pool.ntp.org"

config NTP_TZ
    string "POSIX timezone string"
    default "CET-1CEST,M3.5.0/2,M10.5.0/3"

# GPIO -------------------------------------------------------------------------

config GPIO_BTN_ZONE_1
    string "Button GPIO (zone 1)"
    default 4

config GPIO_BTN_ZONE_2
    string "Button GPIO (zone 2)"
    default 5

config GPIO_BTN_ZONE_3
    string "Button GPIO (zone 3)"
    default 6

config GPIO_BTN_ZONE_4
    string "Button GPIO (zone 4)"
    default 7

config GPIO_BTN_ZONE_5
    string "Button GPIO (zone 5)"
    default 8

config GPIO_BTN_ZONE_6
    string "Button GPIO (zone 6)"
    default 9

endmenu
